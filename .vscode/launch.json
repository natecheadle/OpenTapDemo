  "version": "0.2.0",
  "configurations": [
    {
      "name": "TUI",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/tap.dll",
      "args": [
        "tui"
      ],
      "cwd": "${workspaceFolder}/bin/Debug",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Run test plan",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/tap.dll",
      "args": [
        "run",
        "${workspaceFolder}/DemoTestPlan"
      ],
      "cwd": "${workspaceFolder}/bin/Debug",
      "console": "integratedTerminal"
    }
  ]
}